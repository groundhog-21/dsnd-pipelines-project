# Master style and formats for charts

# Figure
figure.figsize: 8, 5
figure.dpi: 100
figure.facecolor: white
figure.autolayout: True
savefig.dpi: 300
savefig.bbox: tight

# Fonts
font.family: sans-serif
font.sans-serif: Inter, Arial, DejaVu Sans
font.size: 11
axes.titlesize: 14
axes.titleweight: bold
axes.labelsize: 12
xtick.labelsize: 12
ytick.labelsize: 11



# Axes
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.axisbelow: True
axes.prop_cycle: cycler('color', ['4C72B0', 'DD8452', '55A868', 'C44E52', '8172B3', '937860'])
axes.titlepad: 16

# Grid
grid.color: DDDDDD
grid.linestyle: --
grid.linewidth: 0.6

# Lines and markers
lines.linewidth: 2
lines.markersize: 6

# Ticks
xtick.direction: out
ytick.direction: out
xtick.major.size: 4
ytick.major.size: 4

# Legend
legend.frameon: False
legend.fontsize: 10

# Patch
patch.edgecolor: black
patch.force_edgecolor: True